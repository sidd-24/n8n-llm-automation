{
  "name": "Groq Support Classifier",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-intake",
        "responseMode": "responseNode"
      },
      "id": "webhook",
      "name": "Support Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "support-intake"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.GROQ_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"llama-3.3-70b-versatile\",\"temperature\":0.1,\"response_format\":{\"type\":\"json_object\"},\"messages\":[{\"role\":\"system\",\"content\":\"You classify support messages. Return only valid JSON with these fields: category, priority, summary, sentiment, recommended_action. category must be one of billing, technical, account, shipping, other. priority must be one of low, medium, high, urgent. sentiment must be one of positive, neutral, negative.\"},{\"role\":\"user\",\"content\":{{JSON.stringify($json.body || $json)}}}]}"
      },
      "id": "groq",
      "name": "Classify With Groq",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "jsCode": "const source = $('Support Webhook').first().json.body || $('Support Webhook').first().json;\nconst content = $json.choices?.[0]?.message?.content;\n\nif (!content) {\n  throw new Error('Groq returned no message content');\n}\n\nlet result;\ntry {\n  result = JSON.parse(content);\n} catch (error) {\n  throw new Error(`Groq returned invalid JSON: ${content}`);\n}\n\nreturn [{\n  json: {\n    request_id: source.request_id || `req_${Date.now()}`,\n    customer_email: source.customer_email || null,\n    original_message: source.message || null,\n    ...result,\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "normalize",
      "name": "Normalize Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json.priority}}",
              "rightValue": "urgent",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "priority",
      "name": "Urgent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1020, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.DESTINATION_URL}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json}}"
      },
      "id": "destination",
      "name": "Send Urgent Item",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1280, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}",
        "options": {}
      },
      "id": "response-urgent",
      "name": "Return Urgent Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1540, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
